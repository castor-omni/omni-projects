# Bare top-level list (NO `relationships:` wrapper key — Omni rejects it).
# View names assume the schema-layer view name == the table name. If your
# connection prefixes views with the schema (check the Omni IDE file tree, e.g.
# `saas__fact_company_usage_metrics`), prepend that prefix to every view name
# and inside every ${...} reference below.

# ── Hero topic joins (base = fact_company_percentile_rank) ──────────────────
- join_from_view: fact_company_percentile_rank
  join_to_view: dim_metric
  on_sql: ${fact_company_percentile_rank.metric_id} = ${dim_metric.metric_id}
  relationship_type: many_to_one
  join_type: always_left

- join_from_view: fact_company_percentile_rank
  join_to_view: fact_company_usage_metrics
  on_sql: >
    ${fact_company_percentile_rank.account_id} = ${fact_company_usage_metrics.account_id}
    AND ${fact_company_percentile_rank.snapshot_month} = ${fact_company_usage_metrics.snapshot_month}
    AND ${fact_company_percentile_rank.metric_id} = ${fact_company_usage_metrics.metric_id}
  relationship_type: many_to_one
  join_type: always_left

- join_from_view: fact_company_percentile_rank
  join_to_view: fact_benchmark_stats
  on_sql: >
    ${fact_company_percentile_rank.snapshot_month} = ${fact_benchmark_stats.snapshot_month}
    AND ${fact_company_percentile_rank.metric_id} = ${fact_benchmark_stats.metric_id}
    AND ${fact_company_percentile_rank.peer_group_segment} = ${fact_benchmark_stats.peer_group_segment}
    AND ${fact_company_percentile_rank.peer_group_region} = ${fact_benchmark_stats.peer_group_region}
    AND ${fact_company_percentile_rank.peer_group_product_tier} = ${fact_benchmark_stats.peer_group_product_tier}
  relationship_type: one_to_many
  join_type: always_left

# ── Peer-only topic join ────────────────────────────────────────────────────
- join_from_view: fact_benchmark_stats
  join_to_view: dim_metric
  on_sql: ${fact_benchmark_stats.metric_id} = ${dim_metric.metric_id}
  relationship_type: many_to_one
  join_type: always_left

# ── Company-usage topic join ────────────────────────────────────────────────
- join_from_view: fact_company_usage_metrics
  join_to_view: dim_metric
  on_sql: ${fact_company_usage_metrics.metric_id} = ${dim_metric.metric_id}
  relationship_type: many_to_one
  join_type: always_left
