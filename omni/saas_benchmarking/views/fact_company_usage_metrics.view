# Extension view: a company's own monthly metric values, long form.
# Grain: one row per (account_id, snapshot_month, metric_id).
# RLS: RESTRICTED by account_id (applied in the topic via access_filters).
dimensions:
  usage_pk:
    primary_key: true
    hidden: true
    sql: ${account_id} || '-' || ${snapshot_month} || '-' || ${metric_id}
  account_id:
    hidden: true
  metric_id:
    hidden: true
  snapshot_month:
    label: Month
    timeframes: [month, quarter, year]
  segment:
    label: Company Segment
  region:
    label: Company Region
  product_tier:
    label: Company Product Tier
  value:
    hidden: true

measures:
  company_value:
    label: My Value
    description: >
      The company's own value for the selected metric in the selected month.
      Long-form fact — filter to a single metric (via dim_metric.name or
      metric_id) for a meaningful number.
    sql: ${value}
    aggregate_type: sum
