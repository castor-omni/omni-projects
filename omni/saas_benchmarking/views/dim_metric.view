# Extension view: metric catalog. One row per metric_id.
# OPEN (shared dimension, no RLS). Joined by all three fact views.
dimensions:
  metric_id:
    primary_key: true
    hidden: true
  name:
    label: Metric
  category:
    label: Metric Category
    description: "users | events | rate"
  denominator_type:
    label: Rate Denominator
    description: "For rate metrics, the user population the metric is divided by. NULL for counts."
  higher_is_better:
    label: Higher Is Better
  format:
    hidden: true
